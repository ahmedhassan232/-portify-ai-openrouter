{
  "name": "portify-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:export-css": "tailwindcss -c tailwind.export.config.ts -i src/styles/export.css -o public/export/portfolio.css --minify",
    "dev": "npm run build:export-css && next dev",
    "build": "npm run build:export-css && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.9.0",
    "next": "^15.3.0",
    "openai": "^4.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.0",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
